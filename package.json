{
  "name": "@lenso/email-provider-service",
  "version": "0.1.1",
  "description": "Host-managed Lenso Provider Service for transactional email delivery",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test",
    "check:ecosystem": "node scripts/verify-notification-contracts.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { force: true, recursive: true })\"",
    "db:migrate": "tsx src/migrate.ts",
    "dev": "tsx watch src/server.ts",
    "package-readiness": "pnpm check && pnpm build && lenso service package --check . && pnpm pack --dry-run",
    "prepack": "pnpm build",
    "service:package": "lenso service package .",
    "service:verify": "lenso service verify ./lenso.service.json --serve-command \"pnpm start\"",
    "start": "node dist/server.js",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lenso/service-kit": "^0.6.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@lenso/cli": "^0.7.1",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "contracts",
    "migrations",
    "lenso.service.json",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso-email-provider-service.git"
  },
  "homepage": "https://github.com/LioRael/lenso-email-provider-service#readme",
  "bugs": {
    "url": "https://github.com/LioRael/lenso-email-provider-service/issues"
  },
  "packageManager": "pnpm@11.19.0",
  "publishConfig": {
    "access": "public"
  }
}
