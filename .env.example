PORT=4112
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5442/lenso_email
DATABASE_AUTO_MIGRATE=false

# fake is deterministic and intended for local/business acceptance only.
EMAIL_TRANSPORT=fake
EMAIL_FAKE_MODE=delivered

# SMTP configuration. The *_ENV values name environment variables containing
# credentials; they are references, never credentials themselves.
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_MAX_CONNECTIONS=5
EMAIL_SMTP_MAX_MESSAGES=100
EMAIL_SMTP_RATE_LIMIT_PER_SECOND=10
EMAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
EMAIL_SMTP_GREETING_TIMEOUT_MS=5000
EMAIL_SMTP_SOCKET_TIMEOUT_MS=15000
EMAIL_SMTP_USERNAME_ENV=EMAIL_SMTP_USERNAME
EMAIL_SMTP_PASSWORD_ENV=EMAIL_SMTP_PASSWORD
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=notifications@example.com
EMAIL_FROM_NAME=Lenso

EMAIL_DISPATCH_LEASE_MS=30000
EMAIL_PROVIDER_NAME=lenso-email
LENSO_LOCAL_ENROLLMENT_TOKEN=
HOST=127.0.0.1
# Required when HOST is not loopback; configure the same bearer in the Host.
# LENSO_PROVIDER_BEARER_TOKEN=replace-me
